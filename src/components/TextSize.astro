---
/** Réglage de la taille du texte (mémorisé dans le navigateur). */
---

<div class="flex items-center gap-1" role="group" aria-label="Taille du texte">
  <span class="mr-1 text-sm font-semibold text-slate-700">Texte</span>
  <button
    type="button"
    class="text-size-btn text-sm"
    data-text-size="md"
    aria-label="Taille normale"
  >
    A
  </button>
  <button
    type="button"
    class="text-size-btn text-base"
    data-text-size="lg"
    aria-label="Grande taille"
  >
    A+
  </button>
  <button
    type="button"
    class="text-size-btn text-lg"
    data-text-size="xl"
    aria-label="Très grande taille"
  >
    A++
  </button>
</div>
