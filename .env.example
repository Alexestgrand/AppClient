# Connexion PostgreSQL
DATABASE_URL="postgresql://tva:tva@localhost:5432/tva?schema=public"
# Base dédiée aux tests d'intégration (sera VIDÉE par les tests)
TEST_DATABASE_URL="postgresql://tva:tva@localhost:5432/tva_test?schema=public"

# Compte administrateur unique (utilisé par `pnpm admin:create`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changez-moi-avec-un-mot-de-passe-long"

# Durée de vie d'une session (heures)
SESSION_TTL_HOURS=12

# Serveur Node (production)
# Origine publique exacte (protection CSRF), ex. https://tva.mondomaine.fr
# Laisser vide en local : l'hôte de la requête est utilisé.
APP_ORIGIN=

HOST=0.0.0.0
PORT=4321

# Docker Compose uniquement
POSTGRES_USER=tva
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=tva
APP_PORT=4321
